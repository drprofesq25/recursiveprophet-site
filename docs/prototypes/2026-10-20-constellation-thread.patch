+/* ------------------------------------------------------------------
+   PROTOTYPE (Forge, 2026-10-20): constellation + signal thread.
+   Presentation only; no copy changes. Default state is the finished
+   state, so reduced motion, unsupported browsers, and no-JS all see
+   the complete picture. Motion is layered on top inside @supports and
+   prefers-reduced-motion: no-preference.
+   ------------------------------------------------------------------ */
+:root {
+  --gold: #e3b06b;          /* sampled from the cover's linework */
+  --gold-deep: #9a5e17;     /* the same gold, darkened for paper grounds */
+  --thread-x: calc(max(0px, (100vw - 1180px) / 2) + clamp(1.25rem, 5vw, 4rem) / 2);
+}
+
+/* J1: the cover's network leaves the cover */
+.hero-right { z-index: 3; }              /* below .hero-text (5): lines pass behind the headline */
+.cover-wrapper::before { display: none; } /* retire the offset frame; the constellation replaces it */
+
+.constellation {
+  position: absolute;
+  z-index: -2;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+  pointer-events: none;
+  color: var(--gold);
+}
+
+.constellation path {
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 0.8;
+  vector-effect: non-scaling-stroke;
+  opacity: var(--o);
+}
+
+.constellation circle {
+  fill: currentColor;
+  opacity: var(--o);
+}
+
+.constellation .ring {
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 0.8;
+  vector-effect: non-scaling-stroke;
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .constellation path {
+    stroke-dasharray: 1;
+    stroke-dashoffset: 1;
+    animation: c-draw 1.1s var(--ease-out-ui) both;
+    animation-delay: calc(var(--d) * 1s + 0.3s);
+  }
+
+  .constellation circle {
+    animation: c-node 0.6s ease-out both;
+    animation-delay: calc(var(--d) * 1s + 0.3s);
+  }
+}
+
+@keyframes c-draw {
+  from { stroke-dashoffset: 1; }
+  to { stroke-dashoffset: 0; }
+}
+
+@keyframes c-node {
+  from { opacity: 0; transform: scale(0.2); }
+  to { opacity: var(--o); transform: scale(1); }
+}
+
+.constellation circle { transform-box: fill-box; transform-origin: center; }
+
+/* J2: the signal thread. One segment per section, a node at each beat of
+   the narrative: human need → It works. → connection → transformation → entrance. */
+[data-thread] { position: relative; }
+
+.thread {
+  --track: rgba(23, 20, 18, 0.12);
+  --lit: var(--gold-deep);
+  --ground: var(--white);
+  position: absolute;
+  z-index: 1;
+  top: 0;
+  bottom: 0;
+  left: var(--thread-x);
+  width: 1px;
+  background: var(--track);
+  pointer-events: none;
+}
+
+.thread::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: var(--lit);
+  transform-origin: top;
+}
+
+.band-dark .thread { --track: rgba(245, 240, 231, 0.1); --lit: var(--gold); --ground: var(--ink); }
+.synopsis-section .thread { --ground: var(--paper); }
+.sample-band .thread { --ground: var(--paper-warm); }
+
+.thread-node {
+  position: absolute;
+  z-index: 2;
+  top: clamp(4.5rem, 8vw, 8rem);
+  left: 50%;
+  width: 9px;
+  height: 9px;
+  border-radius: 50%;
+  background: var(--lit);
+  box-shadow: 0 0 0 4px color-mix(in srgb, var(--lit) 18%, transparent);
+  transform: translate(-50%, 0.2rem);
+}
+
+/* The hinge of the story gets the largest node. */
+.what-copy { position: static; }   /* let the hinge node measure from .what-grid */
+.thread-node-works {
+  --lit: var(--gold);
+  left: calc(var(--thread-x) - max(0px, (100vw - 1180px) / 2) - clamp(1.25rem, 5vw, 4rem));
+  top: auto;
+  width: 13px;
+  height: 13px;
+  margin-top: 0.62em;
+  transform: translate(-50%, -50%);
+}
+
+/* J4: give "It works." the pause the copy asks for. */
+.what-copy .what-emphasis {
+  margin-block: 2.6rem 2.4rem;
+  font-size: clamp(2.3rem, 4vw, 3.3rem);
+  line-height: 1.1;
+}
+
+@supports (animation-timeline: view()) {
+  @media (prefers-reduced-motion: no-preference) {
+    [data-thread] { view-timeline: --thread block; }
+    .what-emphasis { view-timeline: --works block; }
+
+    .thread::after {
+      animation: thread-fill linear both;
+      animation-range: entry 30% exit 40%;
+    }
+
+    .thread-node {
+      animation: thread-node linear both;
+      animation-range: entry 35% entry 70%;
+    }
+
+    .thread-node-works { animation-range: entry 70% cover 50%; }
+
+    /* Timelines live in their own rules on purpose: the build's CSS minifier
+       folds animation-timeline into the animation shorthand when they share a
+       rule, which is invalid and silently drops the whole declaration. */
+    [data-thread] .thread::after { animation-timeline: --thread; }
+    [data-thread] .thread-node { animation-timeline: --thread; }
+    .what-emphasis .thread-node-works { animation-timeline: --works; }
+  }
+}
+
+@keyframes thread-fill {
+  from { transform: scaleY(0); }
+  to { transform: scaleY(1); }
+}
+
+@keyframes thread-node {
+  from { background: var(--ground); box-shadow: 0 0 0 1px var(--track), 0 0 0 0 transparent; }
+  to { background: var(--lit); box-shadow: 0 0 0 0 transparent, 0 0 0 4px color-mix(in srgb, var(--lit) 18%, transparent); }
+}
+
+@media (max-width: 700px) {
+  .thread-node { width: 7px; height: 7px; box-shadow: 0 0 0 3px color-mix(in srgb, var(--lit) 18%, transparent); }
+  .thread-node-works { width: 10px; height: 10px; }
+}
+
+/* Palette study: "cover night". Re-keys the dark bands to the cover's own navy
+   so the site and the book read as one object. Toggle with <html data-palette="night">. */
+:root[data-palette='night'] {
+  --night: #0a1828;
+  --night-deep: #07111d;
+}
+:root[data-palette='night'] body,
+:root[data-palette='night'] html { background-color: var(--night-deep); }
+:root[data-palette='night'] .hero {
+  background:
+    radial-gradient(circle at 74% 46%, rgba(227, 176, 107, 0.08), transparent 30rem),
+    radial-gradient(circle at 12% 90%, rgba(73, 57, 183, 0.16), transparent 34rem),
+    var(--night);
+}
+:root[data-palette='night'] .band-dark,
+:root[data-palette='night'] .final-section { background-color: var(--night); }
+:root[data-palette='night'] .band-dark .thread { --ground: var(--night); }
+:root[data-palette='night'] .final-section {
+  background: radial-gradient(circle at 50% 35%, rgba(227, 176, 107, 0.09), transparent 26rem), var(--night);
+}
+:root[data-palette='night'] .site-header.scrolled { background: rgba(10, 24, 40, 0.9); }
+:root[data-palette='night'] footer { background: var(--night-deep); }
+:root[data-palette='night'] .site-header { background: linear-gradient(180deg, rgba(10, 24, 40, 0.82), transparent); }
+:root[data-palette='night'] .site-header.scrolled { background: rgba(10, 24, 40, 0.9); }
+
+/* Mobile: tighten the hero so the cover and its constellation peek into the
+   first screen under the two CTAs, instead of starting just below the fold. */
+@media (max-width: 700px) {
+  .hero-text { padding-top: 6.25rem; padding-bottom: 1.5rem; }
+  .hero-annotation { margin-bottom: 1.1rem; }
+  .hero h1 { margin-bottom: 1.25rem; }
+  .hero-italic { margin-bottom: 1.5rem; }
+  .hero-right { padding-top: 2.5rem; }
+}
