---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import WhatThisIs from '../components/WhatThisIs.astro';
import Synopsis from '../components/Synopsis.astro';
import Sample from '../components/Sample.astro';
import Readers from '../components/Readers.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import AboutChris from '../components/AboutChris.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../consts';

const bookStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: SITE.titleShort,
  description: SITE.description,
  url: SITE.url,
  image: new URL(SITE.ogImage, SITE.url).href,
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: SITE.authors,
  },
  // publisher: omitted until the public imprint is chosen ("The Bindery" collides with Bindery Books).
};
---
<BaseLayout structuredData={bookStructuredData}>
  <SiteHeader slot="header" />
  <Hero />
  <WhatThisIs />
  <Readers />
  <Synopsis />
  <Sample />
  <Faq />
  <AboutChris />
  <FinalCta />
  <SiteFooter slot="footer" />
</BaseLayout>
