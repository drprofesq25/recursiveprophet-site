---
import StaticPageLayout from '../../layouts/StaticPageLayout.astro';
---
<StaticPageLayout
  title="Check your inbox."
  description="Confirm your Recursive Prophet email request to receive Chapter 1 and The First File."
  eyebrow="file.001 — confirmation requested"
  noindex
>
  <p>
    Your request has been received. Open the confirmation email from Recursive Prophet and confirm
    your address. Chapter 1 and The First File are sent only after confirmation.
  </p>
  <p>
    If the message does not arrive within a few minutes, check your spam folder or return to the
    form and try again.
  </p>
  <div class="static-actions">
    <a class="static-action" href="/">Return home</a>
    <a class="static-action" href="/#sample">Return to the form</a>
  </div>
</StaticPageLayout>
