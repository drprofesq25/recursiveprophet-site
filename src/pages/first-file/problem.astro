---
import StaticPageLayout from '../../layouts/StaticPageLayout.astro';
---
<StaticPageLayout
  title="The signal broke."
  description="The Recursive Prophet email request could not be completed."
  eyebrow="file.001 — transmission interrupted"
  noindex
>
  <p>
    Something interrupted the request, and your subscription is not complete. Please wait a few
    minutes and try again.
  </p>
  <p>
    If the problem continues, come back later. The Archive is patient. Infrastructure occasionally
    requires the same courtesy.
  </p>
  <div class="static-actions">
    <a class="static-action" href="/#sample">Try the form again</a>
    <a class="static-action" href="/">Return home</a>
  </div>
</StaticPageLayout>
