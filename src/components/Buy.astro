---
import { BUY_LINKS, BUY_LIVE } from '../consts';
---
<section class="buy-band" id="buy" aria-labelledby="buy-heading">
  <div class="section-wrap-sm">
    <div class="section-tag">Get the book</div>

    {BUY_LIVE ? (
      <>
        <h2 class="buy-headline" id="buy-heading">Choose your format.</h2>
        <p class="buy-sub">Buy anywhere, then confirm your purchase to unlock the Archive.</p>
        <ul class="buy-list">
          {BUY_LINKS.map((b) => (
            <li>
              <a href={b.url} class="btn-ink">{b.format}</a>
              <span class="buy-note">{b.note}</span>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <>
        <h2 class="buy-headline" id="buy-heading">The book is not available to order yet.</h2>
        <p class="buy-sub">
          No dead preorder button and no imaginary retailer choice. Start with Chapter 1; a purchase
          path will appear here only when there is a verified destination.
        </p>
        <div class="btn-row">
          <a href="#sample" class="btn-ink">Read Chapter 1</a>
        </div>
        <p class="buy-formats">Current launch plan: ebook + paperback.</p>
      </>
    )}
  </div>
</section>

<style>
  .buy-band { padding: 1rem 0; border-top: 1px solid var(--rule); background: var(--paper-warm); }
  .buy-headline { font-size: clamp(2rem, 4vw, 3.25rem); margin: 0.5rem 0 1rem; }
  .buy-sub { max-width: 52ch; color: var(--muted); }
  .buy-list { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .buy-list li { display: flex; flex-direction: column; gap: 0.4rem; }
  .buy-note, .buy-formats {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .buy-formats { margin-top: 1.5rem; }
</style>
