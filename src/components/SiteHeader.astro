---
import { BUY_LIVE } from '../consts';

interface Props {
  solid?: boolean;
}

const { solid = false } = Astro.props;
---
<header class:list={['site-header', { scrolled: solid }]} id="site-header" data-solid={solid}>
  <a href="/#book" class="wordmark">Recursive Prophet</a>
  <nav class="site-nav" aria-label="Primary">
    <a href="/#story">Story</a>
    <a href="/#archive">Archive</a>
    <a href="/#about">About</a>
    <a href={BUY_LIVE ? '/#buy' : '/#sample'} class="nav-cta">
      {BUY_LIVE ? 'Buy the book' : 'Read Chapter 1'}
    </a>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header && header.dataset.solid !== 'true') {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 80);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
