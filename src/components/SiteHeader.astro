---
interface Props {
  solid?: boolean;
}

const { solid = false } = Astro.props;
---
<header class:list={['site-header', { scrolled: solid }]} id="site-header" data-solid={solid}>
  <a href="/#book" class="wordmark">Recursive Prophet</a>
  <nav class="site-nav" aria-label="Primary">
    <a href="/#story">The Book</a>
    <a href="/#readers">Who It’s For</a>
    <a href="/#making">How It Was Made</a>
    <a href="/#sample">The Archive</a>
    <a href="/#about-chris">About Chris</a>
    <a href="/#sample" class="nav-cta">Read Chapter One</a>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header && header.dataset.solid !== 'true') {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 80);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
