<header class="site-header" id="site-header">
  <a href="#book" class="wordmark">Recursive Prophet</a>
  <nav class="site-nav" aria-label="Primary">
    <a href="#book">Book</a>
    <a href="#archive">Archive</a>
    <a href="#about">About</a>
    <a href="#sample">Newsletter</a>
    <a href="#buy" class="nav-cta">Buy / Preorder</a>
  </nav>
</header>

<script>
  // Progressive enhancement only: adds a class once scrolled past the hero lip.
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 80);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
