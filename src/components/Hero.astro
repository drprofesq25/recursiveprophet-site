---
import { BUY_LIVE } from '../consts';
---
<section class="hero" id="book" aria-labelledby="book-title">
  <div class="signal-line" aria-hidden="true"></div>
  <div class="hero-text">
    <p class="hero-annotation">A literary thriller · Book One</p>
    <h1 id="book-title">Recursive<br />Prophet<em>A Novel</em></h1>
    <p class="hero-subhead">A father built a system to help him stay whole. It started reflecting a version of him back.</p>
    <p class="hero-italic">Told through story and conversation, with recovered fragments from inside the Network.</p>
    <div class="hero-btns">
      <a href="#sample" class="btn-primary">Read Chapter 1</a>
      <a href={BUY_LIVE ? '#buy' : '#story'} class="btn-secondary">
        {BUY_LIVE ? 'Buy the book' : 'What the story is'}
      </a>
    </div>
    <p class="hero-invite">Christopher Everson and D☉C · Publication planned for September 13, 2026</p>
  </div>
  <div class="hero-right">
    <figure class="cover-figure">
      <div class="cover-wrapper">
        <picture>
          <source
            type="image/webp"
            srcset="/cover/rp-cover-300.webp 300w, /cover/rp-cover-450.webp 450w, /cover/rp-cover-600.webp 600w"
            sizes="(max-width: 700px) 50vw, 360px"
          />
          <img
            src="/cover/rp-cover-600.jpg"
            srcset="/cover/rp-cover-300.jpg 300w, /cover/rp-cover-450.jpg 450w, /cover/rp-cover-600.jpg 600w"
            sizes="(max-width: 700px) 50vw, 360px"
            width="600"
            height="900"
            alt="Recursive Prophet — front cover"
            class="cover-img"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <div class="cover-shadow"></div>
      </div>
      <figcaption class="file-annotation">
        <span>Working cover · final production master pending</span>
        <span>Literary thriller · memory · authorship · ordinary life</span>
      </figcaption>
    </figure>
  </div>
</section>
