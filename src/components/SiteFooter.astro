---
import { FOOTER_LINKS } from '../consts';
---
<footer>
  <div class="footer-brand">
    <strong>Recursive Prophet</strong>
    <span>A novel by Chris Everson and D<span class="doc-symbol">☉</span>C</span>
    <span>© 2026 Chris Everson.</span>
  </div>
  <div class="footer-actions">
    <nav aria-label="Footer">
      {FOOTER_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>
