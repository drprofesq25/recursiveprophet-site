<script>
  const synopsisDetails = document.querySelector<HTMLDetailsElement>('.synopsis-details');
  const mobileSynopsis = window.matchMedia('(max-width: 700px)');
  const syncSynopsis = (query: MediaQueryList | MediaQueryListEvent) => {
    if (!synopsisDetails) return;
    synopsisDetails.open = !query.matches;
    synopsisDetails.dataset.ready = '';
  };
  syncSynopsis(mobileSynopsis);
  mobileSynopsis.addEventListener('change', syncSynopsis);
</script>
