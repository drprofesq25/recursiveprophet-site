---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  noindex?: boolean;
}

const { title, description, eyebrow, noindex = false } = Astro.props;
---
<BaseLayout
  title={`${title} — ${SITE.titleShort}`}
  description={description}
  ogType="website"
  noindex={noindex}
>
  <section class="static-page">
    <div class="static-page-inner">
      <a class="static-home" href="/" aria-label="Recursive Prophet home">Recursive Prophet</a>
      {eyebrow && <p class="static-eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <div class="static-content">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .static-page {
    min-height: 100vh;
    padding: clamp(2rem, 6vw, 5rem) 1.5rem;
    background:
      linear-gradient(135deg, rgba(92, 79, 214, 0.08), transparent 42%),
      var(--paper);
  }
  .static-page-inner {
    width: min(100%, 46rem);
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4.5rem);
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid var(--rule);
  }
  .static-home,
  .static-eyebrow {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .static-home {
    display: inline-block;
    color: var(--ink);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .static-eyebrow {
    margin-top: clamp(3rem, 8vw, 6rem);
    color: var(--signal);
  }
  h1 {
    max-width: 14ch;
    margin-top: 0.75rem;
    font-family: var(--cormorant);
    font-size: clamp(3rem, 9vw, 5.75rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }
  .static-content {
    margin-top: 2rem;
    font-size: 1rem;
  }
  .static-content :global(p + p),
  .static-content :global(p + ul),
  .static-content :global(ul + p),
  .static-content :global(section + section) {
    margin-top: 1rem;
  }
  .static-content :global(h2) {
    margin-top: 2.5rem;
    font-family: var(--cormorant);
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 400;
    line-height: 1.1;
  }
  .static-content :global(ul) { padding-left: 1.25rem; }
  .static-content :global(a) {
    color: var(--signal);
    text-underline-offset: 0.2em;
  }
  .static-content :global(.static-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
  .static-content :global(.static-action) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .static-content :global(.static-action:hover) {
    background: var(--ink);
    color: var(--paper);
  }
  @media (max-width: 520px) {
    .static-page { padding: 0; }
    .static-page-inner { min-height: 100vh; border: 0; }
  }
</style>
