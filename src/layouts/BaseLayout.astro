---
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  socialTitle?: string;
  socialDescription?: string;
  noIndex?: boolean;
  ogType?: 'book' | 'website';
  structuredData?: Record<string, unknown>;
}
const {
  title = SITE.title,
  description = SITE.description,
  socialTitle = SITE.shareTitle,
  socialDescription = SITE.shareDescription,
  noIndex = false,
  ogType = 'book',
  structuredData,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(SITE.ogImage, Astro.site ?? SITE.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.authors} />
    <meta name="theme-color" content={SITE.themeColor} />
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-normal-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/libre-baskerville-normal-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.titleShort} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    <meta property="og:image:type" content={SITE.ogImageType} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 999;
    padding: 0.75rem 1.25rem;
    background: var(--paper, #f3eee4);
    color: var(--ink, #171412);
    font-family: var(--mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }
  :focus-visible {
    outline: 3px solid var(--focus, #a79dff);
    outline-offset: 4px;
  }
</style>
